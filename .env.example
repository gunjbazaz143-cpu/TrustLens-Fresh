# Copy to .env and adjust for your environment
SECRET_KEY=change-me-to-a-long-random-string
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=trustlens
# Set to 1 to force MySQL; otherwise SQLite is used for quick local runs
USE_MYSQL=0
# Bootstrap admin account (single admin = official admin mailbox)
ADMIN_EMAIL=gunjbazaz143@gmail.com
ADMIN_PASSWORD=Admin@12345

# --- Email notifications (Flask-Mail) ---
# Where scam reports + contact-form messages are delivered
MAIL_ALERT_RECIPIENT=gunjbazaz143@gmail.com
# SMTP credentials (e.g. Gmail app password) - required for actual dispatch
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1

# --- Threat intelligence (optional) ----
# Leave blank to skip Safe Browsing / VirusTotal lookups during QR & URL scans
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
